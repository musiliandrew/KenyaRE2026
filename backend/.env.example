# ==============================================================================
# Kenya Re Catastrophe Risk Intelligence Platform - Backend Environment Config
# COPY THIS FILE TO .env AND FILL IN YOUR LOCAL CONFIGURATION / SECRETS
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL + PostGIS Database Configuration (Neon Cloud or Local)
DATABASE_URL=postgresql://user:password@host-pooler.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.aws.neon.tech/neondb?sslmode=require
PGHOST=host-pooler.aws.neon.tech
PGUSER=user
PGDATABASE=neondb
PGPASSWORD=password

# Pillar 1 (Hazard) & Exposure Data Paths
DATA_DIR=./data
NAIROBI_EXPOSURE_CSV=./data/exposure_nairobi_synthetic.csv
NAIROBI_EXPOSURE_HAZARD_CSV=./data/exposure_nairobi_with_hazard.csv
NAIROBI_HOTSPOTS_CSV=./data/nairobi_hotspots_geocoded.csv
HAZARD_RASTERS_DIR=./data/rasters

# AI & LLM Intelligence Layer (Policy slip parsing, underwriting summaries)
# Provide your OpenAI or compatible API key for natural language processing:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Mapbox Access Token (if geocoding or spatial verification server-side)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

